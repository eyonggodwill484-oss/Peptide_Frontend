NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (Project Settings > API in Supabase). Server-only, never expose to the client.
# Required for order persistence, cart-session tracking, and the abandoned-cart cron.
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
# Verified sending address once a custom domain is set up in Resend, e.g.:
#   Wardiere Peptide Sciences <orders@mail.wardierepeptidesciences.com>
# Leave blank to fall back to the Resend sandbox sender during development.
RESEND_FROM_EMAIL=

# Random secret shared with Vercel Cron's Authorization header for /api/cron/* routes.
CRON_SECRET=

# Comma-separated Supabase Auth emails allowed into /admin/orders (no roles system yet).
ADMIN_EMAILS=

# Sentry Error Monitoring Configuration
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog Analytics Configuration
# Get your Project API Key from https://us.posthog.com/settings/project (or eu.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
